LIUYING_DATA_DIR=.data
# Default local mode: SQLite + a bounded local job supervisor.
# Use Docker Compose to run PostgreSQL + Redis + Celery.
LIUYING_QUEUE_MODE=local
LIUYING_DATABASE_URL=
LIUYING_REDIS_URL=redis://redis:6379/0
LIUYING_MAX_BYTES=8589934592
LIUYING_MAX_DURATION=14400
LIUYING_DOWNLOAD_TIMEOUT=14400
LIUYING_ARTIFACT_TTL=3600
# Optional, self-hosted Evil0ctal v5. API key stays on the server.
# 抖音解析优先走该服务;未配置时使用"本机 Chrome 铸造访客身份 + 原生 a_bogus/secsdk 签名"
# (免登录,需要服务端机器装有 Chrome/Chromium)。
LIUYING_DTK_URL=
LIUYING_DTK_API_KEY=
# Optional administrator-provided Netscape cookie file, local/self-hosted use only.
# Never expose a personal authenticated instance as an anonymous public service.
LIUYING_COOKIE_FILE=
# 海外平台(YouTube / TikTok / Instagram / X)的出口代理,http(s)://主机:端口。
# 留空时自动继承环境变量 https_proxy / http_proxy;两者都为空则直连。
# 国内平台(抖音 / 快手 / 小红书 / B站)始终直连,不走该代理。
# LIUYING_PROXY=http://127.0.0.1:7890
# 公网访问密码:非空时首页与全部接口(健康检查除外)要求输入该密码;留空=无密码,仅限本机使用。
LIUYING_ACCESS_PASSWORD=
# HTTPS 访问(Cloudflare Tunnel / 反代)下开启安全 Cookie
LIUYING_SECURE_COOKIE=false
LIUYING_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]

